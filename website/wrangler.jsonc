// A static site on Cloudflare Workers: no Worker script, only assets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carton",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "carton.dtcristo.com", "custom_domain": true }]
}
