---
// The sidebar's section switcher. Each tab is a top-level section, and only the
// current section's tree shows below the tabs.
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const sections = [
  { label: 'Start here', path: '/start/', icon: 'rocket' },
  { label: 'Guides', path: '/guides/', icon: 'book' },
  { label: 'Reference', path: '/reference/', icon: 'code' },
];

const { sidebar } = Astro.locals.starlightRoute;
const here = Astro.url.pathname;
const current = sections.find((s) => here.startsWith(s.path)) ?? sections[0];

// A section's tab links to the first page in its tree.
type Entry = { type: string; href?: string; label: string; entries?: Entry[] };
function firstLink(entries: Entry[]): string | undefined {
  for (const e of entries) {
    if (e.type === 'link') return e.href;
    const inner = e.entries && firstLink(e.entries);
    if (inner) return inner;
  }
}
const group = (label: string) => sidebar.filter((g: Entry) => g.label === label) as Entry[];
const tabs = sections.map((s) => ({ ...s, href: firstLink(group(s.label)) }));
// The current section's own entries, without its group heading: the tab names it.
const tree = group(current.label).flatMap((g) => g.entries ?? []);
// SidebarPersister keys saved open/closed state by a hash of the route's
// sidebar. Hash this section's tree instead, so one section's saved state is
// never applied to another's. Nothing reads the full sidebar after this.
Astro.locals.starlightRoute.sidebar = tree;
---

<nav class="section-tabs" aria-label="Sections">
  {tabs.map((s) => (
    <a href={s.href} aria-current={s.label === current.label ? 'page' : undefined}>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        {s.icon === 'rocket' && <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />}
        {s.icon === 'book' && <path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2zM22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z" />}
        {s.icon === 'code' && <><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></>}
      </svg>
      <span>{s.label}</span>
    </a>
  ))}
</nav>
<SidebarPersister>
  <SidebarSublist sublist={tree} />
</SidebarPersister>
<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .section-tabs {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem;
    border: 1px solid var(--carton-line);
    border-radius: 0.9rem;
    background: var(--carton-tab);
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 0.6rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  a svg {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--sl-color-gray-4);
  }

  a:hover {
    color: var(--sl-color-white);
  }

  a[aria-current='page'] {
    border-color: var(--carton-line);
    background: var(--carton-card);
    color: var(--sl-color-white);
  }

  a[aria-current='page'] svg {
    color: var(--carton-ruby);
  }
</style>
