---
// The sidebar's section switcher. Each tab is a top-level section, and only the
// selected section's tree shows below the tabs without navigating away.
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const sections = [
  { label: 'Start here', path: '/start/', icon: 'rocket' },
  { label: 'Guides', path: '/guides/', icon: 'book' },
  { label: 'Reference', path: '/reference/', icon: 'code' },
];

const { sidebar } = Astro.locals.starlightRoute;
const here = Astro.url.pathname;
const current = sections.find((s) => here.startsWith(s.path)) ?? sections[0];

const trees = sections.map((section) => ({
  ...section,
  entries: sidebar.flatMap((group) => group.label === section.label && group.type === 'group' ? group.entries : []),
}));
---

<carton-sidebar>
  <nav class="section-tabs" aria-label="Sections" hidden>
    {trees.map((s, index) => (
      <button type="button" id={`section-button-${index}`} aria-controls={`section-tree-${index}`} aria-pressed={s.label === current.label}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          {s.icon === 'rocket' && <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />}
          {s.icon === 'book' && <path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2zM22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z" />}
          {s.icon === 'code' && <><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></>}
        </svg>
        <span>{s.label}</span>
      </button>
    ))}
  </nav>
  <SidebarPersister>
    {trees.map((section, index) => (
      <section id={`section-tree-${index}`} aria-labelledby={`section-button-${index}`}>
        <h2 data-section-heading>{section.label}</h2>
        <SidebarSublist sublist={section.entries} />
      </section>
    ))}
  </SidebarPersister>
</carton-sidebar>

<script>
  import { initSidebar } from '../sidebar.mjs';

  customElements.define('carton-sidebar', class extends HTMLElement {
    connectedCallback() {
      initSidebar(this);
    }
  });
</script>
<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  carton-sidebar {
    display: block;
  }

  .section-tabs[hidden] {
    display: none;
  }

  .section-tabs {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem;
    border: 1px solid var(--carton-line);
    border-radius: 0.9rem;
    background: var(--carton-tab);
  }

  button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 0.6rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    background: transparent;
    font-family: inherit;
    text-align: start;
    cursor: pointer;
  }

  button svg {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--sl-color-gray-4);
  }

  button:hover {
    color: var(--sl-color-white);
  }

  button[aria-pressed='true'] {
    border-color: var(--carton-line);
    background: var(--carton-card);
    color: var(--sl-color-white);
  }

  button[aria-pressed='true'] svg {
    color: var(--carton-ruby);
  }
</style>
