---
// The sidebar's section switcher. Each tab is a top-level section, and only the
// selected section's tree shows below the tabs without navigating away.
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { Icon } from '@astrojs/starlight/components';

const sections = [
  { label: 'Start here', path: '/start/', icon: 'gem' },
  { label: 'Guides', path: '/guides/', icon: 'open-book' },
  { label: 'Reference', path: '/reference/', icon: 'document' },
] as const;

const { sidebar } = Astro.locals.starlightRoute;
const here = Astro.url.pathname;
const current = sections.find((s) => here.startsWith(s.path)) ?? sections[0];

const trees = sections.map((section) => ({
  ...section,
  entries: sidebar.flatMap((group) => group.label === section.label && group.type === 'group' ? group.entries : []),
}));
---

<carton-sidebar>
  <nav class="section-tabs" aria-label="Sections" hidden>
    {trees.map((s, index) => (
      <button type="button" id={`section-button-${index}`} aria-controls={`section-tree-${index}`} aria-pressed={s.label === current.label}>
        {s.icon === 'gem' ? (
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 3h12l4 6-10 12L2 9Z" />
            <path d="M2 9h20M6 3l6 18 6-18" />
          </svg>
        ) : <Icon name={s.icon} size="1.1rem" />}
        <span>{s.label}</span>
      </button>
    ))}
  </nav>
  <SidebarPersister>
    {trees.map((section, index) => (
      <section id={`section-tree-${index}`} aria-labelledby={`section-button-${index}`}>
        <h2 data-section-heading>{section.label}</h2>
        <SidebarSublist sublist={section.entries} />
      </section>
    ))}
  </SidebarPersister>
</carton-sidebar>

<script>
  import { initSidebar } from '../sidebar.mjs';

  customElements.define('carton-sidebar', class extends HTMLElement {
    connectedCallback() {
      initSidebar(this);
    }
  });
</script>
<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  carton-sidebar {
    display: block;
  }

  .section-tabs[hidden] {
    display: none;
  }

  .section-tabs {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1.25rem;
    padding: 0.35rem;
    border: 1px solid var(--carton-line);
    border-radius: 0.9rem;
    background: var(--carton-tab);
  }

  button {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 0.6rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    background: transparent;
    font-family: inherit;
    text-align: start;
    cursor: pointer;
  }

  button :global(svg) {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--sl-color-gray-4);
  }

  button:hover {
    color: var(--sl-color-white);
  }

  button[aria-pressed='true'] {
    border-color: var(--carton-line);
    background: var(--carton-card);
    color: var(--sl-color-white);
  }

  button[aria-pressed='true'] :global(svg) {
    color: var(--carton-ruby);
  }
</style>
