---
// Replaces Starlight's hero on the homepage (the only page with `hero` set).
// The figure shows Carton's whole idea at small scale: main.rb imports billing,
// billing imports tax, and Tax is not reachable from main.rb.
import { Image } from 'astro:assets';
import logo from '../assets/carton.png';
import CopyCommand from './CopyCommand.astro';
---

<section class="hero not-content">
  <div class="pitch">
    <div class="lockup">
      <Image src={logo} alt="" width={320} class="logo" loading="eager" />
      <div>
        <h1>Carton</h1>
        <p class="tagline">Real boundaries for Ruby</p>
      </div>
    </div>
    <p class="lede">
      Split an app into Cartons that import and export like plain modules. Each Carton runs in its own <code>Ruby::Box</code>, so Ruby enforces the boundary while code runs.
    </p>
    <div class="cta">
      <div class="actions">
        <a class="button primary" href="/start/getting-started/">Get started</a>
        <a class="button" href="https://github.com/dtcristo/carton">View on GitHub</a>
      </div>
      <CopyCommand command="gem install carton" />
    </div>
  </div>

  <figure class="demo" aria-label="main.rb imports the billing Carton, which imports the tax Carton. main.rb can call Billing but cannot reach Tax.">
    <div class="file importer">
      <p class="file-label">main.rb</p>
      <pre class="code"><code><span class="k">require</span> <span class="s">'carton'</span>

<span class="c">Billing</span> = <span class="n">import_relative</span> <span class="s">'billing'</span>
<span class="c">Billing</span>.invoice(<span class="m">100</span>) <span class="r"># =&gt; 110</span>
<span class="c">Tax</span>                  <span class="x"># NameError: billing's import</span></code></pre>
    </div>

    <div class="carton">
      <p class="carton-label">billing Carton</p>
      <div class="file">
        <p class="file-label">billing.rb</p>
        <pre class="code"><code><span class="c">Tax</span> = <span class="n">import_relative</span> <span class="s">'tax'</span>

<span class="k">module</span> <span class="c">Billing</span>
  <span class="k">def</span> <span class="k">self</span>.invoice(total) = total + <span class="c">Tax</span>.on(total)
<span class="k">end</span>

<span class="n">export</span> <span class="c">Billing</span></code></pre>
      </div>

      <div class="carton inner">
        <p class="carton-label">tax Carton</p>
        <div class="file">
          <p class="file-label">tax.rb</p>
          <pre class="code"><code><span class="k">module</span> <span class="c">Tax</span>
  <span class="k">def</span> <span class="k">self</span>.on(total) = total / <span class="m">10</span>
<span class="k">end</span>

<span class="n">export</span> <span class="c">Tax</span></code></pre>
        </div>
      </div>
    </div>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-block: 2rem 4rem;
  }

  /* Margins follow the header: phones below 50rem (where the search collapses)
     are tight; tablets from 50rem to 64rem keep the section margins. */
  @media (max-width: 49.99rem) {
    .hero {
      padding-inline: 0.5rem;
    }
  }

  @media (min-width: 50rem) and (max-width: 63.99rem) {
    .hero {
      padding-inline: clamp(1rem, 4vw, 2.5rem);
    }
  }

  /* Desktop from 64rem: two equal columns. The gap narrows just before the snap
     to one column, and the lockup keeps its size across the desktop range. */
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 6vw, 6rem);
      padding-block: 4rem 5rem;
    }

    .lockup {
      --wordmark: 6rem;
    }
  }

  /* The logo tracks the wordmark with a 7rem floor and a 9rem cap. The tagline
     is a fixed share of the wordmark, so the two lines match in width. */
  .lockup {
    --wordmark: clamp(3.5rem, 2rem + 5vw, 6rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .logo {
    display: block;
    flex: none;
    width: clamp(7rem, calc(var(--wordmark) * 1.5), 9rem);
    height: auto;
    filter: drop-shadow(0 18px 22px rgb(90 60 30 / 0.34)) drop-shadow(0 4px 6px rgb(90 60 30 / 0.12));
  }

  :root:not([data-theme='light']) .logo {
    filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.5)) drop-shadow(0 4px 6px rgb(0 0 0 / 0.25));
  }

  h1 {
    margin: 0;
    font-size: var(--wordmark);
    font-weight: 600;
    line-height: 0.95;
    /* Any tighter and overlapping glyphs show a seam, as between r and t. */
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--sl-color-white);
  }

  .tagline {
    margin: 0.6rem 0 0;
    font-size: calc(var(--wordmark) * 0.275);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--carton-ink-soft);
  }

  /* Lockup and paragraph share one 30rem block, centred; the buttons are 24rem.
     Phones shrink the block to the screen. The paragraph is left-aligned. */
  .lockup,
  .lede {
    width: 100%;
    margin-inline: auto;
  }

  /* Below the snap the copy is a 30rem block, centred. */
  @media (max-width: 63.99rem) {
    .lockup,
    .lede {
      width: min(100%, 30rem);
    }
  }

  .lede {
    margin-block: 2.25rem 0;
    font-size: var(--sl-text-lg);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  .lede code {
    padding: 0.1em 0.3em;
    border-radius: 0.35rem;
    background: var(--carton-ruby-wash);
    color: var(--sl-color-accent-high);
    font-size: 0.86em;
    font-weight: 500;
  }

  /* The install command matches the width of the buttons above it. */
  .cta {
    display: grid;
    gap: 2rem;
    width: min(100%, 24rem);
    margin: 2.5rem auto 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .actions .button {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    padding-inline: 1.5rem;
    white-space: nowrap;
  }

  /* Narrow phones: tighter button padding so both labels fit on one row. */
  @media (max-width: 30rem) {
    .actions .button {
      padding-inline: 1rem;
    }
  }

  .cta :global(.copy-command) {
    display: flex;
    justify-content: space-between;
  }

  /* Secondary buttons keep their outline and card fill; only the label turns
     ruby. Primary deepens its fill. Both transition the same way. */
  .button {
    display: inline-flex;
    align-items: center;
    padding: 0.9rem 1.75rem;
    border-radius: 999px;
    border: 1px solid var(--carton-line);
    background: var(--carton-card);
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms, color 150ms;
  }

  .button:hover {
    color: var(--carton-ruby);
  }

  /* A fixed ruby in both themes keeps white text above 4.5:1 contrast. */
  .button.primary {
    background: #cc342d;
    border-color: #cc342d;
    color: #fff;
  }

  .button.primary:hover {
    background: #9e2520;
    border-color: #9e2520;
    color: #fff;
  }

  /* The figure: code cards like the docs', each Carton a ruby-tinted tray. */

  .demo {
    margin: 0;
    display: grid;
    gap: 2rem;
    font-size: var(--sl-text-sm);
  }

  .file {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--carton-line);
    border-radius: 0.9rem;
    background: var(--carton-card);
    box-shadow: var(--carton-shadow);
  }

  .carton {
    position: relative;
    display: grid;
    gap: 1.75rem;
    min-width: 0;
    padding: 2rem 1.5rem 1.5rem;
    border: 1.5px solid var(--carton-tray-edge);
    border-radius: 1.25rem;
    background: var(--carton-tray);
  }

  /* A nested Carton sits a shade deeper. */
  .carton.inner {
    background: var(--carton-tray-deep);
  }

  .carton-label {
    position: absolute;
    top: -0.85rem;
    left: 1rem;
    margin: 0;
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    background: #cc342d;
    color: #fff;
    font-size: var(--sl-text-xs);
    font-weight: 600;
  }

  .file-label {
    margin: 0;
    padding: 0.6rem 1.25rem;
    border-bottom: 1px solid var(--carton-line);
    background: var(--carton-tab);
    color: var(--carton-ink-soft);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 600;
  }

  .code {
    margin: 0;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    line-height: 1.65;
    color: var(--code-text);
    font-family: var(--__sl-font-mono);
    white-space: pre;
  }

  .code code {
    padding: 0;
    background: none;
    font-size: inherit;
  }

  .k { color: var(--code-keyword); font-weight: 700; }
  .c { color: var(--code-constant); }
  .n { color: var(--code-call); }
  .s { color: var(--code-string); }
  .m { color: var(--code-literal); }
  .r { color: var(--code-result); font-weight: 700; }
  .x { color: var(--code-error); font-weight: 700; }

  /* One quiet entrance: the two outer panels fade in, a beat apart. */
  @media (prefers-reduced-motion: no-preference) {
    .importer,
    .carton:not(.inner) {
      animation: fade-in 500ms ease-out both;
    }

    .carton:not(.inner) { animation-delay: 120ms; }
  }

  @keyframes fade-in {
    from { opacity: 0; }
  }
</style>
