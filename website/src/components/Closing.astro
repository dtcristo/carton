---
// The homepage's last word and its footer: a full-bleed ruby band pointing at
// the tutorial, flush with the bottom of the page.
import CopyCommand from './CopyCommand.astro';
---

<section class="closing not-content" aria-labelledby="closing">
  <h2 id="closing">Draw your first boundary</h2>
  <p>Install the gem, export a module from one file, and import it from another. Carton is experimental and needs Ruby 4.0.7 or later, run with <code>RUBY_BOX=1</code>.</p>
  <div class="actions">
    <a class="button" href="/start/getting-started/">Read Getting started</a>
    <CopyCommand command="gem install carton" />
  </div>
  <footer>
    <nav aria-label="Footer">
      <a href="/project/why-carton/">Why Carton</a>
      <a href="/project/status/">Status</a>
      <a href="/reference/kernel/">Reference</a>
      <a href="https://github.com/dtcristo/carton">GitHub</a>
    </nav>
    <p>MIT License</p>
  </footer>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    margin-block: 4rem 0;
    padding-block: 4.5rem 2rem;
    color: #fff;
  }

  /* The band spans the window, past the content column. */
  .closing::before,
  .closing::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 auto;
    left: 50%;
    width: 100vw;
    translate: -50% 0;
  }

  .closing::before {
    background:
      radial-gradient(50rem 24rem at 85% 0%, rgb(255 255 255 / 0.18), transparent 70%),
      linear-gradient(135deg, #b0123d, #6d0b2a 60%, #3a0a24);
  }

  .closing::after {
    --facet: rgb(255 255 255 / 0.07);
    background:
      repeating-linear-gradient(60deg, var(--facet) 0 1px, transparent 1px 56px),
      repeating-linear-gradient(-60deg, var(--facet) 0 1px, transparent 1px 56px),
      repeating-linear-gradient(0deg, var(--facet) 0 1px, transparent 1px 48.5px);
    mask-image: linear-gradient(to left, #000, transparent 80%);
  }

  h2 {
    margin: 0;
    font-family: var(--carton-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #fff;
  }

  p {
    margin: 1rem 0 2rem;
    max-width: 34rem;
    font-size: var(--sl-text-lg);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.82);
  }

  p code {
    font-size: 0.875em;
    padding: 0.05em 0.35em;
    border-radius: 0.25rem;
    background: rgb(0 0 0 / 0.25);
    color: #fff;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .button {
    display: inline-flex;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    background: #fff;
    color: #6d0b2a;
    font-weight: 700;
    text-decoration: none;
    transition: transform 150ms;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .closing :focus-visible {
    outline-color: #fff;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.18);
    font-size: var(--sl-text-sm);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
  }

  nav a {
    color: #fff;
    font-weight: 650;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  footer p {
    margin: 0;
    font-size: inherit;
    color: rgb(255 255 255 / 0.7);
  }

  /* The copy command reads on the band in both themes. */
  .actions :global(.copy-command) {
    --carton-panel: rgb(0 0 0 / 0.28);
    --carton-panel-edge: rgb(255 255 255 / 0.18);
  }

  .actions :global(.copy-command code) {
    color: #fff;
  }

  .actions :global(.copy-command button) {
    background: rgb(255 255 255 / 0.16);
    color: #fff;
  }

  .actions :global(.copy-command button:hover) {
    background: rgb(255 255 255 / 0.26);
  }

  .actions :global(.copy-command button[data-copied]) {
    background: var(--carton-boundary);
    color: var(--sl-color-black);
  }
</style>
