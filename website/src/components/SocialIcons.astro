---
// Starlight's header has no link slot, so the Docs and Examples links ride
// with the social icons, ahead of the GitHub icon.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a class="nav-link" href="/start/getting-started/">Docs</a>
<a class="nav-link" href="/guides/examples/">Examples</a>
<Default />

<style>
  /* Same header hover as the wordmark and GitHub icon: ink, then ruby. */
  /* Stock social-link box: the negative margin cancels the padding, so the flex gap alone sets the spacing. */
  .nav-link {
    padding: 0.5em;
    margin: -0.5em;
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--carton-ruby);
  }
</style>
