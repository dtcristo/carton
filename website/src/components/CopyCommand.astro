---
// A shell command with a copy button. The button confirms with "Copied".
interface Props {
  command: string;
}
const { command } = Astro.props;
---

<div class="copy-command not-content">
  <code><span class="prompt" aria-hidden="true">$</span> {command}</code>
  <button type="button" data-command={command}>Copy</button>
</div>

<script>
  // Bind on every page: with the client router, a page swap does not rerun this module.
  const bindCopyButtons = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-command button')) {
      if (button.dataset.bound !== undefined) continue;
      button.dataset.bound = '';
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(button.dataset.command ?? '');
        button.textContent = 'Copied';
        button.dataset.copied = '';
        setTimeout(() => {
          button.textContent = 'Copy';
          delete button.dataset.copied;
        }, 1600);
      });
    }
  };
  bindCopyButtons();
  document.addEventListener('astro:page-load', bindCopyButtons);
</script>

<style>
  /* A one-line terminal, coloured like the docs' shell blocks in theme.css. */
  .copy-command {
    --copy-button: rgb(248 245 238 / 0.14);
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.55rem 0.55rem 0.55rem 1.25rem;
    border: 1px solid var(--carton-shell-edge);
    border-radius: 0.9rem;
    background: var(--carton-shell-bg);
    box-shadow: var(--carton-shadow);
  }

  :global([data-theme='light']) .copy-command {
    --copy-button: var(--sl-color-gray-6);
  }

  code {
    padding: 0;
    background: none;
    color: var(--carton-shell-text);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-sm);
  }

  /* One fixed ruby for the prompt in both themes, like the band's other fixed colours. */
  .prompt {
    color: #cc342d;
    user-select: none;
  }

  button {
    padding: 0.4rem 0.85rem;
    border: 0;
    border-radius: 0.45rem;
    background: var(--copy-button);
    color: var(--carton-shell-text);
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: color 150ms;
  }

  button:hover {
    color: var(--carton-ruby);
  }

  button[data-copied] {
    background: #cc342d;
    color: #fff;
  }
</style>
