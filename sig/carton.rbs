module Kernel
  private

  def import: (::String path) -> untyped
  def import_relative: (::String path) -> untyped
  def export: (*::Symbol names, **untyped values) -> ::Symbol?
  def export_default: [T] (T value) -> T
end

module Carton
  VERSION: ::String

  def self.setup_bundle: (*::Symbol groups, ?gemfile: ::String?) -> untyped
end

class Carton::Error < ::StandardError
end

class Carton::ImportError < Carton::Error
end

class Carton::ExportError < Carton::Error
end

class Carton::GemfileNotFound < Carton::Error
end

# Lookup helpers on every `Carton::Exports`. `carton rbs` extends its
# generated `Carton::Exports::*` modules with these.
module Carton::ExportMethods
  type key = ::String | ::Symbol

  # Exported methods come back as Method objects; values as exported.
  def []: (key key) -> untyped
  def deconstruct_keys: (nil keys) -> ::Hash[::Symbol, untyped]
                      | (::Array[::Symbol] keys) -> ::Hash[::Symbol, untyped]
  def fetch: (key key) -> untyped
           | (key key, untyped default) -> untyped
           | [T] (key key) { (key key) -> T } -> (untyped | T)
  def fetch_values: (*key keys) -> ::Array[untyped]
  def keys: () -> ::Array[::Symbol]
  def to_h: () -> ::Hash[::Symbol, untyped]
  def has_key?: (key key) -> bool
  def key?: (key key) -> bool
  def values_at: (*key keys) -> ::Array[untyped]
end

class Carton::Exports < ::Module
  include ::Carton::ExportMethods
end
