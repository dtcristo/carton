module Kernel
  private

  def import: (::String | ::Pathname path) -> untyped
  def import_relative: (::String | ::Pathname path) -> untyped
  def export: [T] (T value) -> T
end

module Carton
  VERSION: ::String

  def self.setup_bundle: (*(::Symbol | ::String) groups, ?gemfile: ::String?) -> untyped
end

class Carton::Error < ::StandardError
end

class Carton::ImportError < Carton::Error
end

class Carton::ExportError < Carton::Error
end

class Carton::GemfileNotFound < Carton::Error
end
