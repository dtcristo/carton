# frozen_string_literal: true

source 'https://rubygems.org'

gem 'carton', path: '../..'

# Each Carton is a path gem. Its gemspec is its manifest: name, version, and
# the dependencies it may import.
gem 'billing', path: 'cartons/billing'
gem 'pricing', path: 'cartons/pricing'
gem 'shipping', path: 'cartons/shipping'

# The app's lockfile pins third-party versions for every Carton.
gem 'bigdecimal', '4.1.1'

# The tests in test/ run under this same bundle.
group :test do
  gem 'minitest', '~> 5.16'
end
