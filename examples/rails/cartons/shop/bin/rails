#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../config/boot'

# Carton boundary: runner evaluates user code in Main. These are references to the shared
# modules, not another require of Rails or the Engine implementations.
module ShopCLI
  Framework = import 'framework'
  Customers = import 'customers'
  Billing = import 'billing'
end
Rails = ShopCLI::Framework::Rails
Customers = ShopCLI::Customers
Billing = ShopCLI::Billing
Dir.chdir(File.expand_path('..', __dir__))
ShopCLI::Framework.cli(
  ARGV,
  application: File.expand_path('../config/application', __dir__),
)
