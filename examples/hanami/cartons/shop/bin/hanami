#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../config/boot'

# Carton boundary: import in a module, so the CLI's constants stay out of
# Object.
module ShopCLI
  App = import 'shop'
  Framework = import 'framework'
end

script = File.expand_path(__FILE__)
Dir.chdir(File.expand_path('..', __dir__))
ShopCLI::Framework.cli(ARGV.dup, script: script)
